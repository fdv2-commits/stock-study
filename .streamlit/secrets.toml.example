# Streamlit Cloud 배포용 비밀값 예시.
# 실제 값은 이 파일이 아니라 Streamlit Cloud 화면(App settings → Secrets)에 붙여 넣는다.
# 값은 큰따옴표로 감싼다.

# 학습 기록 보관 (배포 환경은 재시작하면 파일이 사라지므로 필요)
# 스윙 대시보드와 같은 토큰·저장소를 쓴다. 기록은 저장소 안 stock_study/ 폴더에 따로 저장된다.
GITHUB_DATA_TOKEN = ""       # 스윙 대시보드 Secrets에 넣은 것과 같은 값
GITHUB_DATA_REPO = ""        # 예: "내아이디/swing-data"

# 화면 비밀번호 (앱 주소를 아는 다른 사람이 들어오지 못하게)
APP_PASSWORD = ""
